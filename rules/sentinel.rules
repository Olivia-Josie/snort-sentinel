# Snort Sentinel - regles de detection de base
# Auteur: Olivia Josie Kompane

#detecte un scan  de ports Nmap (SYN scan)
alert tcp any any  -> #HOME_NET any (msg:"Possible scan de ports Nmap detecte"; flags:S; threshold: type both, track by_src, count 20, seconds 60; sid:1000001; rev:1;)

#detecte une tentaive de connexion SSH suspecte (bruteforce)
alert tcp any any ->#HOME_NET 22 (msg:"Tentative de connexion SSH suspecte"; flags:S; threshold: type both, track by_src, count 5, secondes 60; sid:1000002; rev:1;)

#detecte une tentative de connexion FTP suspecte 
alert tcp any any -> $HOME_NET 21 (msg:"Tentative de connexion FTP suspecte"; flags:S; threshold: type both, track by_src, count 5, secondes 60; sid:1000003; rev:1;)
